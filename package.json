{
  "name": "hitcore",
  "version": "1.0.0",
  "private": true,
  "description": "IPSC training logger, microphone shot timer and hit factor reports",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "manage": "node --disable-warning=ExperimentalWarning server/manage.js",
    "demo": "python3 -m http.server 8080",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  }
}
